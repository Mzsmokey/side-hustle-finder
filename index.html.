<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101d36"><title>Side Hustle Finder</title><link rel="manifest" href="manifest.webmanifest"><style>*{box-sizing:border-box}body{margin:0;background:#eaf0f6;font:16px system-ui,-apple-system,sans-serif;color:#12223a}.app{max-width:520px;min-height:100vh;margin:auto;background:#fff;padding-bottom:86px}header{background:#101d36;color:white;padding:24px 20px 28px;border-radius:0 0 28px 28px}header small{color:#b6d3dc}.brand{font-weight:800;letter-spacing:.2px}.hero{font-size:29px;line-height:1.12;margin:25px 0 10px}.muted{color:#68798b}.intro{color:#d7e3ed}main{padding:20px}.pill{display:inline-block;background:#e6f8ed;color:#14663c;padding:5px 10px;border-radius:30px;font-size:12px;font-weight:700}h2{font-size:20px}label{display:block;font-weight:650;margin:15px 0 7px}select{width:100%;border:1px solid #cbd5e1;border-radius:12px;padding:13px;background:white;font:inherit}.card{border:1px solid #dce5ee;border-radius:18px;padding:17px;margin:12px 0;box-shadow:0 2px 6px #101d3609}.card h3{margin:0 0 7px}.tag{font-size:12px;color:#22624b;background:#e7f7ed;border-radius:20px;padding:5px 8px;display:inline-block}.button{background:#12233d;color:white;border:0;border-radius:12px;padding:13px 16px;font:inherit;font-weight:700;cursor:pointer;width:100%;margin-top:10px}.secondary{background:#e7eff8;color:#142b49}.premium{background:#101d36;color:white;border-radius:20px;padding:20px;margin-top:20px}.premium p{color:#d4deeb}.price{font-size:35px;font-weight:800}.price span{font-size:15px;font-weight:400}.notice{background:#fff8e6;border-radius:12px;padding:12px;font-size:13px;color:#6b4c0c}nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);max-width:520px;width:100%;background:#fff;border-top:1px solid #e1e8f0;display:flex;justify-content:space-around;padding:12px}nav button{border:0;background:none;color:#334b65;font:inherit;font-size:13px;cursor:pointer}.hide{display:none}</style></head><body><div class="app"><header><div class="brand">💸 Side Hustle Finder</div><h1 class="hero">Find your next way to earn.</h1><p class="intro">Realistic opportunities. Clear requirements. No income promises.</p><small>FREE PREVIEW • NO SIGN-UP REQUIRED</small></header><main><section id="explore"><span class="pill">Try it free</span><h2>Find your match</h2><label for="kind">What interests you?</label><select id="kind"><option value="all">All opportunities</option><option value="remote">Work from home</option><option value="local">Local services</option><option value="creative">Creative & digital</option></select><label for="pay">Payment preference</label><select id="pay"><option value="all">All payment types</option><option value="cash">Cash</option><option value="commission">Commission</option></select><div id="results"></div><div class="notice">These are example side-hustle categories, not verified job openings. Actual opportunities and earnings depend on eligibility and availability.</div><div class="premium"><span class="pill">Premium plan</span><h2>Unlock more possibilities</h2><div class="price">$4.99 <span>/ month</span></div><p>Planned: verified listings, official application links, personalized matches, saved opportunities, and beginner guides.</p><button class="button secondary" onclick="showTab('premium')">See membership details</button></div></section><section id="premium" class="hide"><h2>Side Hustle Finder Premium</h2><div class="price">$4.99 <span>/ month</span></div><p>Our Stripe subscription product is configured. Online checkout and member accounts are not connected yet.</p><div class="notice">Membership sign-ups are not open. We won't collect money until the service and cancellation process work.</div><button class="button" onclick="showTab('explore')">Explore free preview</button></section><section id="about" class="hide"><h2>About this preview</h2><p>Side Hustle Finder helps people discover ways to earn extra income, from online services to local gigs. The free preview demonstrates filtering and matching only.</p><p>Future listings will show their official source, eligibility, compensation type, fees, and last verification date.</p><p class="muted">No earnings are guaranteed. Never pay an individual to unlock a job.</p></section></main><nav><button onclick="showTab('explore')">⌕ Explore</button><button onclick="showTab('premium')">★ Premium</button><button onclick="showTab('about')">ⓘ About</button></nav></div><script>const data=[{name:'Virtual Assistant',kind:'remote',pay:'cash',desc:'Offer scheduling, research, or inbox support to clients.'},{name:'Local Pet Sitting',kind:'local',pay:'cash',desc:'Help pet owners with care and visits in your area.'},{name:'Digital Template Seller',kind:'creative',pay:'cash',desc:'Create and sell useful digital downloads.'},{name:'Affiliate Content',kind:'creative',pay:'commission',desc:'Earn commissions from eligible product referrals.'},{name:'Online Tutoring',kind:'remote',pay:'cash',desc:'Teach a subject or skill you know well.'},{name:'Home Organization',kind:'local',pay:'cash',desc:'Offer decluttering and organizing services.'}];function render(){let kind=document.getElementById('kind').value,pay=document.getElementById('pay').value;let matches=data.filter(x=>(kind==='all'||x.kind===kind)&&(pay==='all'||x.pay===pay));document.getElementById('results').innerHTML='<h2>Sample matches ('+Math.min(3,matches.length)+')</h2>'+(matches.slice(0,3).map(x=>'<article class="card"><h3>'+x.name+'</h3><span class="tag">'+(x.pay==='cash'?'Cash opportunities':'Commission opportunities')+'</span><p class="muted">'+x.desc+'</p></article>').join('')||'<p>No sample matches. Try another filter.</p>')}function showTab(id){['explore','premium','about'].forEach(x=>document.getElementById(x).classList.toggle('hide',x!==id));window.scrollTo(0,0)}document.querySelectorAll('select').forEach(x=>x.addEventListener('change',render));render();if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});</script></body></html>
